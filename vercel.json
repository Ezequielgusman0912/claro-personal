{
  "builds": [
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {"distDir": "staticfiles"}
    },
    {"src": "pagos/wsgi.py", "use": "@vercel/python"}
  ],
  "routes": [
    {"src": "/static/(.*)", "dest": "/static/$1"},
    {"src": "/(.*)", "dest": "pagos/wsgi.py"}
  ]
}
